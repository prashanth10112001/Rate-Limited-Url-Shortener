
@baseUrl = http://localhost:8000

### Register user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "username": "john",
    "email": "john@example.com",
    "password": "secret123"
}

### Login user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "username": "john",
    "password": "secret123"
}

### Get current user
GET {{baseUrl}}/auth/me
