@short_code = q


# ---------- SERVER ---------------------

### Health check
GET {{baseUrl}}/health


# ---------- AUTHENTICATION ---------------------

### Register user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "username": "john",
    "email": "john@example.com",
    "password": "secret123"
}

### Login user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "username": "john",
    "password": "secret123"
}

### Get current user
GET {{baseUrl}}/auth/me
Authorization: bearer {{access_token}}


# ---------- URLS ---------------------

### Create short URL
POST {{baseUrl}}/api/shorten
Content-Type: application/json
Authorization: bearer {{access_token}}

{
    "long_url": "https://www.google.com"
}

### Redirect
GET {{baseUrl}}/v

### Get my URLs
GET {{baseUrl}}/api/my-urls
Authorization: bearer {{access_token}}

### Delete URL
DELETE {{baseUrl}}/api/urls/v
Authorization: bearer {{access_token}}

### Update URL expiration
PATCH {{baseUrl}}/api/urls/w/expiration
Content-Type: application/json
Authorization: bearer {{access_token}}

{
    "expires_at" : "2026-12-31T23:59:59Z"
}

# ---------- ANALYTICS ---------------------

### Get URL statistics
GET {{baseUrl}}/api/stats/w
Authorization: Bearer {{access_token}}


# -------- RATE LIMITER ------------------

### Check rate limiter
GET {{baseUrl}}/d